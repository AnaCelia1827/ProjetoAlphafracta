# You may copy this file to .env to customize local MongoDB settings.
# Docker Compose has matching defaults, so a fresh clone works without .env.
# MONGO_INITDB_* credentials only apply when the mongo_data volume is first initialized.
# To change them later, recreate your local MongoDB volume.
PORT=3001
MONGO_INITDB_ROOT_USERNAME=alphractal
MONGO_INITDB_ROOT_PASSWORD=alphractal_dev_password
MONGO_INITDB_DATABASE=alphractal
MONGODB_URI=mongodb://alphractal:alphractal_dev_password@localhost:27017/alphractal?authSource=admin
