# Endereço público da API Express consumida pelo navegador.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Use true enquanto os endpoints do backend ainda não estiverem disponíveis.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Blocos são opcionais no MVP; habilite quando GET /blocks/recent existir.
NEXT_PUBLIC_ENABLE_RECENT_BLOCKS=false
